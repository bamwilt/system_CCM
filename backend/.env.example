# SGPM Backend - Variables de entorno
# Copiar a .env y ajustar valores

# Servidor
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5433
DB_NAME=sgpm_dev
DB_USER=sgpm_user
DB_PASSWORD=sgpm_dev_password
DB_POOL_MIN=2
DB_POOL_MAX=10

# JWT (cambiar en produccion)
JWT_SECRET=change-me-in-production-use-strong-secret
JWT_EXPIRES_IN=8h

# CORS
CORS_ORIGIN=http://localhost:5173

# Logging
LOG_LEVEL=info
