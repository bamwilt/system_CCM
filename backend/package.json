{
  "name": "sgpm-backend",
  "version": "1.0.0",
  "description": "SGPM Backend - Sistema de Gestion de Pagos y Matriculas",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "migrate": "tsx src/scripts/migrate.ts",
    "seed": "tsx src/scripts/seed.ts",
    "bootstrap:auth": "tsx src/scripts/bootstrap-auth.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "pg": "^8.13.0",
    "dotenv": "^16.4.0",
    "helmet": "^8.0.0",
    "cors": "^2.8.5",
    "zod": "^3.24.0",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.11.0",
    "@types/cors": "^2.8.17",
    "@types/morgan": "^1.9.9",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.7",
    "typescript": "^5.7.0",
    "tsx": "^4.19.0",
    "vitest": "^2.1.0",
    "eslint": "^9.15.0",
    "@eslint/js": "^9.15.0",
    "typescript-eslint": "^8.15.0",
    "supertest": "^7.0.0",
    "@types/supertest": "^6.0.2"
  }
}
