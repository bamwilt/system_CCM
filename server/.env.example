# ============================================================================
#  Configuración del servidor. Copiar a .env y completar.
#    cp server/.env.example server/.env
#
#  IMPORTANTE: .env está en .gitignore. Nunca subas este archivo al repositorio.
# ============================================================================

# --- Base de datos -------------------------------------------------------
# Host y puerto del servidor PostgreSQL.
DB_HOST=127.0.0.1
DB_PORT=5432

# Rol de PostgreSQL. Debe tener permiso CREATEDB para que db/reset-db.sh
# pueda recrear la base. Crear el rol (una sola vez, requiere sudo):
#   sudo -u postgres psql -c "CREATE ROLE <TU_USUARIO> LOGIN PASSWORD '<CLAVE>' CREATEDB;"
DB_USER=bamw
DB_PASSWORD=

# Nombre de la base de datos de la aplicación.
DB_NAME=sistemadb

# --- API -----------------------------------------------------------------
PORT=4000
NODE_ENV=development

# Secreto para firmar los JWT. Generar uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Origenes permitidos por CORS (separados por coma).
# Debe incluir el puerto de Vite.
CORS_ORIGIN=http://localhost:5173

# Coste de bcrypt para el hash de contraseñas (10 = ~100ms, razonable).
BCRYPT_ROUNDS=12